# Kal settings for development. Copy to .env.local and fill in. Never commit real values.

# Database (DATABASE_URL, or the standard PGHOST/PGUSER/PGPASSWORD/PGDATABASE variables).
DATABASE_URL=postgres://cal:change-me@127.0.0.1:5432/cal

# Encrypts AI keys and integration credentials (base64 of 32 random bytes):
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CAL_SECRET_KEY=

# Where photos are stored (default ./data/photos).
PHOTO_ROOT=./data/photos

# Plain http on 127.0.0.1 needs non-secure cookies; leave unset (secure) behind https.
COOKIE_SECURE=false

# Public address, used in invite links printed by scripts/cal.mjs.
BASE_URL=http://127.0.0.1:3000

# Outbound proxy for AI providers and integrations (the Squid allowlist in the Docker stack).
# EGRESS_PROXY_URL=http://egress:3128

# Food data. FoodData Central downloads (cal import-fdc) are cached here, never in the repository.
# FDC_CACHE_DIR=/var/cache/cal-fdc
# Open Food Facts barcode lookups: API base, a contact for the User-Agent, cache days.
# OFF_BASE_URL=https://world.openfoodfacts.org
# OFF_CONTACT=admin@example.org
# OFF_CACHE_DAYS=30

# Integrations: addresses are set here only, never by users. Leave one out to turn it off.
# MEALIE_BASE_URL=https://mealie.example.org
# OPENGYM_BASE_URL=https://gym.example.org
# INTEGRATION_TIMEOUT_MS=8000

# Web Push (notifications). Make the keys with: node scripts/cal.mjs vapid --out vapid.env
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:admin@example.org
# Extra push service host names beyond the known ones (comma separated).
# PUSH_SERVICE_HOSTS=

# The Kal Android app (built by scripts/android-build.mjs). ANDROID_APP_ID is the app's package
# name (the kal.appId it was built with), ANDROID_CERT_SHA256 the SHA-256 fingerprints of its
# signing certificates, comma separated, for /.well-known/assetlinks.json, and ANDROID_APK_DIR the
# folder holding kal.apk and version.json. Without them "Kal for Android" says the app is not set up.
# ANDROID_APP_ID=app.kal
# ANDROID_CERT_SHA256=
# ANDROID_APK_DIR=./data/android

# Limits (defaults shown).
# MAX_LOGIN_ATTEMPTS=5
# LOGIN_LOCK_MINUTES=15
# SESSION_DAYS=30
# AI_RATE_PER_MINUTE=10
# AI_RATE_PER_DAY=300
# UPLOAD_RATE_PER_HOUR=60
# UPLOAD_RATE_PER_DAY=300
# IMPORT_RATE_PER_HOUR=120
# HEALTH_CONNECT_RATE_PER_HOUR=120
# PHOTO_MAX_PIXELS=40000000
# WORKER_CONCURRENCY=2
# JOB_TIMEOUT_MS=300000
# AI_REQUEST_TIMEOUT_MS=120000

# Tests: a throwaway Postgres container (see tests/helpers/postgres.ts).
# CAL_TEST_PG_CONTAINER=cal-test-postgres
# CAL_TEST_PG_PORT=55432
# CAL_TEST_DATABASE_URL=   # use an existing server instead of a container
