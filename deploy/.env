# Kal stack: pinned versions and non-secret defaults. Docker Compose reads this file by itself
# (it is also handed to the app and the worker). It holds no secrets and no addresses of your
# server: the addresses go in site.env, the secrets in db.env, app.env, vapid.env and
# cloudflared.env (the *.env.example files here are the templates).

# ---- Pinned versions (change one, then run Start.ps1, to update) ----
# Keep Postgres on the same major version (18.x); a new major needs a dump and restore.
CAL_NODE_VERSION=24.22.1-alpine3.24
CAL_POSTGRES_VERSION=18.6-alpine3.24
CAL_SQUID_VERSION=7.2-26.04_edge
CAL_CLOUDFLARED_VERSION=2026.10.0

# ---- Sign-in ----
# Days a sign-in lasts on a device.
SESSION_DAYS=30
# Lock an account for LOGIN_LOCK_MINUTES after this many wrong passwords in a row.
MAX_LOGIN_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

# ---- Limits per account (counted by Kal itself, on top of the providers' own limits) ----
AI_RATE_PER_MINUTE=10
AI_RATE_PER_DAY=300
UPLOAD_RATE_PER_HOUR=60
UPLOAD_RATE_PER_DAY=300
# How long one AI provider request may take, in milliseconds.
AI_REQUEST_TIMEOUT_MS=120000

# ---- Photos and jobs ----
# Largest photo Kal will decode, in pixels (phones send 2048 px photos, about 3 million).
PHOTO_MAX_PIXELS=40000000
# Photos analysed at the same time, and the longest one analysis job may run, in milliseconds.
WORKER_CONCURRENCY=2
JOB_TIMEOUT_MS=300000

# ---- Food data and integrations ----
# Open Food Facts (barcode lookups). The proxy allows its default host automatically; a different
# OFF_BASE_URL in site.env is added to the allowlist when the egress container starts.
OFF_BASE_URL=https://world.openfoodfacts.org
OFF_CACHE_DAYS=30
# How long a Mealie or openGym request may take, in milliseconds.
INTEGRATION_TIMEOUT_MS=8000

# ---- Folders on this computer (optional; paths are relative to this folder) ----
# CAL_PHOTOS_DIR=./photos
# CAL_BACKUP_DIR=./backups
