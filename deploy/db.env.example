# Database login, read by the db, app and worker containers only. Start.ps1 makes db.env with a
# random password on the first start; this template shows what it holds. Do not change the
# password afterwards: the database keeps the one it was created with.
POSTGRES_USER=cal
POSTGRES_DB=cal
POSTGRES_PASSWORD=change-me-to-a-long-random-password
PGUSER=cal
PGDATABASE=cal
PGPASSWORD=change-me-to-a-long-random-password
