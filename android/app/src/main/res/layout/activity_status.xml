<?xml version="1.0" encoding="utf-8"?>
<!-- Board 15: linked or not, what was sent, Send now, access, how Kal uses the data, Unlink. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="14dp"
        android:paddingEnd="16dp"
        android:paddingBottom="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/back"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_round"
                android:contentDescription="@string/status_back"
                android:src="@drawable/ic_back" />

            <TextView
                style="@style/Kal.Title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:accessibilityHeading="true"
                android:text="@string/status_title" />
        </LinearLayout>

        <!-- Status -->
        <LinearLayout
            android:id="@+id/status_card"
            style="@style/Kal.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/dot"
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/dot" />

                <TextView
                    android:id="@+id/status"
                    style="@style/Kal.Heading"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:accessibilityLiveRegion="polite" />
            </LinearLayout>

            <GridLayout
                android:id="@+id/facts"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:columnCount="2"
                android:useDefaultMargins="false">

                <TextView
                    style="@style/Kal.Caption"
                    android:layout_marginEnd="14dp"
                    android:layout_marginBottom="6dp"
                    android:text="@string/status_last_sent"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/last_sent"
                    style="@style/Kal.Body"
                    android:layout_width="0dp"
                    android:layout_gravity="fill_horizontal"
                    android:layout_marginBottom="6dp"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    style="@style/Kal.Caption"
                    android:layout_marginEnd="14dp"
                    android:layout_marginBottom="6dp"
                    android:text="@string/status_today"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/today"
                    style="@style/Kal.Body"
                    android:layout_width="0dp"
                    android:layout_gravity="fill_horizontal"
                    android:layout_marginBottom="6dp"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    style="@style/Kal.Caption"
                    android:layout_marginEnd="14dp"
                    android:text="@string/status_next"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/next"
                    style="@style/Kal.Body"
                    android:layout_width="0dp"
                    android:layout_gravity="fill_horizontal"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </GridLayout>

            <TextView
                android:id="@+id/result"
                style="@style/Kal.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:accessibilityLiveRegion="polite"
                android:visibility="gone" />

            <Button
                android:id="@+id/send_now"
                style="@style/Kal.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:minHeight="48dp"
                android:text="@string/status_send_now"
                android:textSize="15sp" />

            <Button
                android:id="@+id/link_again"
                style="@style/Kal.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:minHeight="48dp"
                android:text="@string/status_link_again"
                android:textSize="15sp"
                android:visibility="gone" />
        </LinearLayout>

        <TextView
            android:id="@+id/update"
            style="@style/Kal.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_note"
            android:padding="14dp"
            android:textColor="@color/kal_on_warning_soft"
            android:textSize="14sp"
            android:visibility="gone" />

        <Button
            android:id="@+id/update_button"
            style="@style/Kal.Button.Secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/status_update_button"
            android:visibility="gone" />

        <!-- Access -->
        <LinearLayout
            android:id="@+id/access"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_card"
            android:contentDescription="@string/status_access_label"
            android:divider="@drawable/divider"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="6dp"
            android:paddingEnd="16dp"
            android:paddingBottom="6dp"
            android:showDividers="middle">

            <include
                android:id="@+id/access_activity"
                layout="@layout/item_access" />

            <include
                android:id="@+id/access_body"
                layout="@layout/item_access" />

            <include
                android:id="@+id/access_background"
                layout="@layout/item_access" />

            <Button
                android:id="@+id/change_access"
                style="@style/Kal.Button.Link"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/status_change_access" />
        </LinearLayout>

        <TextView
            android:id="@+id/note"
            style="@style/Kal.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_note"
            android:padding="14dp"
            android:textColor="@color/kal_on_warning_soft" />

        <LinearLayout
            style="@style/Kal.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp">

            <TextView
                style="@style/Kal.Heading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:accessibilityHeading="true"
                android:text="@string/status_how_title" />

            <TextView
                style="@style/Kal.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/status_how_body"
                android:textSize="14sp" />

            <TextView
                style="@style/Kal.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/status_how_note"
                android:textSize="12sp" />
        </LinearLayout>

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:minHeight="14dp" />

        <Button
            android:id="@+id/unlink"
            style="@style/Kal.Button.Danger"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/status_unlink" />
    </LinearLayout>
</ScrollView>
