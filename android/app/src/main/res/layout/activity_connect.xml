<?xml version="1.0" encoding="utf-8"?>
<!-- Board 14: what Kal can read, the background choice, and the button that asks Health Connect. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="28dp"
        android:paddingEnd="20dp"
        android:paddingBottom="24dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_kal" />

            <TextView
                style="@style/Kal.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:text="@string/app_name"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/title"
            style="@style/Kal.Title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:accessibilityHeading="true"
            android:text="@string/connect_title"
            android:textSize="26sp" />

        <TextView
            style="@style/Kal.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/connect_intro"
            android:textColor="@color/kal_text_soft" />

        <LinearLayout
            android:id="@+id/kinds"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_card"
            android:contentDescription="@string/connect_list_label"
            android:divider="@drawable/divider"
            android:orientation="vertical"
            android:showDividers="middle" />

        <CheckBox
            android:id="@+id/background"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:buttonTint="@color/kal_primary"
            android:checked="true"
            android:minHeight="48dp"
            android:paddingStart="8dp"
            android:text="@string/connect_background"
            android:textColor="@color/kal_text"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/background_note"
            style="@style/Kal.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/connect_background_unavailable"
            android:visibility="gone" />

        <TextView
            android:id="@+id/message"
            style="@style/Kal.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:accessibilityLiveRegion="polite"
            android:background="@drawable/bg_note"
            android:padding="14dp"
            android:textColor="@color/kal_on_warning_soft"
            android:visibility="gone" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:minHeight="16dp" />

        <TextView
            style="@style/Kal.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/connect_footer" />

        <Button
            android:id="@+id/how"
            style="@style/Kal.Button.Link"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/connect_how"
            android:textSize="13sp" />

        <ProgressBar
            android:id="@+id/progress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:indeterminateTint="@color/kal_primary"
            android:visibility="gone" />

        <Button
            android:id="@+id/choose"
            style="@style/Kal.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/connect_choose" />

        <Button
            android:id="@+id/not_now"
            style="@style/Kal.Button.Text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/connect_not_now" />
    </LinearLayout>
</ScrollView>
