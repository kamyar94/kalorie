<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The native screens: Kal's colours on the platform's Material theme, no action bar. -->
    <style name="Theme.Kal" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:colorPrimary">@color/kal_primary</item>
        <item name="android:colorAccent">@color/kal_primary</item>
        <item name="android:colorBackground">@color/kal_bg</item>
        <item name="android:windowBackground">@color/kal_bg</item>
        <item name="android:textColorPrimary">@color/kal_text</item>
        <item name="android:textColorSecondary">@color/kal_muted</item>
        <item name="android:statusBarColor">@color/kal_bg</item>
        <item name="android:navigationBarColor">@color/kal_bg</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <!-- The launcher hands over to the browser at once; androidbrowserhelper draws the splash. -->
    <style name="Theme.Kal.Launcher" parent="android:Theme.Translucent.NoTitleBar" />

    <!-- The root of the Kal.* view styles below (they inherit by name). -->
    <style name="Kal" />

    <style name="Kal.Card">
        <item name="android:background">@drawable/bg_card</item>
        <item name="android:padding">16dp</item>
        <item name="android:orientation">vertical</item>
    </style>

    <style name="Kal.Title">
        <item name="android:textColor">@color/kal_text</item>
        <item name="android:textSize">22sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Kal.Heading">
        <item name="android:textColor">@color/kal_text</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Kal.Body">
        <item name="android:textColor">@color/kal_text</item>
        <item name="android:textSize">15sp</item>
        <item name="android:lineSpacingMultiplier">1.15</item>
    </style>

    <style name="Kal.Caption">
        <item name="android:textColor">@color/kal_muted</item>
        <item name="android:textSize">13sp</item>
        <item name="android:lineSpacingMultiplier">1.15</item>
    </style>

    <style name="Kal.Button" parent="android:Widget.Material.Button.Borderless">
        <item name="android:minHeight">52dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">20dp</item>
    </style>

    <style name="Kal.Button.Primary">
        <item name="android:background">@drawable/bg_button_primary</item>
        <item name="android:textColor">@color/kal_on_primary</item>
    </style>

    <style name="Kal.Button.Secondary">
        <item name="android:background">@drawable/bg_button_secondary</item>
        <item name="android:textColor">@color/kal_text</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:textSize">15sp</item>
    </style>

    <style name="Kal.Button.Danger">
        <item name="android:background">@drawable/bg_button_secondary</item>
        <item name="android:textColor">@color/kal_danger</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:textSize">15sp</item>
    </style>

    <style name="Kal.Button.Text">
        <item name="android:background">@drawable/bg_button_text</item>
        <item name="android:textColor">@color/kal_text</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:textSize">15sp</item>
    </style>

    <style name="Kal.Button.Link">
        <item name="android:background">@drawable/bg_button_text</item>
        <item name="android:textColor">@color/kal_primary</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:textSize">15sp</item>
        <item name="android:gravity">start|center_vertical</item>
        <item name="android:paddingStart">0dp</item>
        <item name="android:paddingEnd">0dp</item>
    </style>
</resources>
